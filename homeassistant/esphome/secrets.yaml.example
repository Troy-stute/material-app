# Kopie als secrets.yaml im ESPHome-Add-on anlegen (nie ins Repo hochladen)
wifi_ssid: "Bunker-WLAN"
wifi_passwort: "hier-euer-passwort"
# 32 Byte, Base64 – ESPHome erzeugt beim Anlegen eines Geräts selbst einen Schlüssel
abluft_api_key: "HIER-SCHLUESSEL-AUS-ESPHOME-EINFUEGEN="
abluft_ota_passwort: "hier-ein-langes-passwort"
